{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pfrsim",
  "version": "0.1.0",
  "identifier": "com.pfrsim.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter pfrsim-desktop dev",
    "beforeBuildCommand": "pnpm --filter pfrsim-desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pfrsim — Peatland Fire Risk Simulator",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
